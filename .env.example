# Copy to .env and fill in. Local dev: PostgreSQL on localhost:5432 (native install or `docker compose up -d`).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/plc_pos?schema=public"
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# 32+ random characters, e.g. `openssl rand -base64 48`
JWT_SECRET="change-me-to-a-long-random-secret-of-32+chars"
# Optional: ACCESS_TOKEN_TTL=900 (seconds), REFRESH_TOKEN_TTL_DAYS=7, PIN_SESSION_TTL_HOURS=12

# --- Production / security (all optional) ---
# NODE_ENV=production            # turns Swagger off unless SWAGGER_ENABLED=true
# CORS_ORIGINS="https://pos.example.la,https://admin.example.la"
# TRUST_PROXY=1                  # behind one reverse proxy (nginx, Caddy, load balancer)
# THROTTLE_LIMIT=600             # requests/minute per IP
# THROTTLE_AUTH_LIMIT=10         # login/PIN/approval/refresh attempts per minute per IP
# BODY_LIMIT=1mb
# DATABASE_POOL_MAX=10
# DATABASE_STATEMENT_TIMEOUT_MS=30000

# --- Multiple companies (SaaS) ---
# DEFAULT_TENANT_CODE=plc        # single-company install: login without a company code
# SIGNUP_ENABLED=false           # self-service sign-up at POST /api/public/signup
# THROTTLE_SIGNUP_LIMIT=3        # sign-ups per hour per IP
# Seed: SEED_TENANT_CODE=plc SEED_ADMIN_PASSWORD=… PLATFORM_ADMIN_EMAIL=… PLATFORM_ADMIN_PASSWORD=…

# --- E-mail, Google, plan billing ---
# APP_URL="https://pos.example.la"     # used in e-mail links
# MAIL_TRANSPORT=smtp                  # smtp | log (default) | memory
# SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
# SMTP_USER=you@gmail.com   SMTP_PASSWORD="gmail app password"
# MAIL_FROM="PLC POS <you@gmail.com>"
# GOOGLE_CLIENT_IDS="xxxx.apps.googleusercontent.com"
# BILLING_BANK_INFO="BCEL 010-12-00-xxxxxx PLC POS"
# BILLING_PAY_URL="https://pay.example/checkout?ref={number}&amount={amount}"
# BILLING_WEBHOOK_SECRET="long random secret"
