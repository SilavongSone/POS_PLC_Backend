# Copy to .env and fill in. Local dev: PostgreSQL on localhost:5432 (native install or `docker compose up -d`).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/plc_pos?schema=public"
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# 32+ random characters, e.g. `openssl rand -base64 48`
JWT_SECRET="change-me-to-a-long-random-secret-of-32+chars"
# Optional: ACCESS_TOKEN_TTL=900 (seconds), REFRESH_TOKEN_TTL_DAYS=7, PIN_SESSION_TTL_HOURS=12

# --- Production / security (all optional) ---
# NODE_ENV=production            # turns Swagger off unless SWAGGER_ENABLED=true
# CORS_ORIGINS="https://pos.example.la,https://admin.example.la"
# TRUST_PROXY=1                  # behind one reverse proxy (nginx, Caddy, load balancer)
# THROTTLE_LIMIT=600             # requests/minute per IP
# THROTTLE_AUTH_LIMIT=10         # login/PIN/approval/refresh attempts per minute per IP
# BODY_LIMIT=1mb
# DATABASE_POOL_MAX=10
# DATABASE_STATEMENT_TIMEOUT_MS=30000
