# PLC POS production settings. Copy to .env and fill in every value.
# Generate secrets with: openssl rand -base64 48

# Domain whose DNS A record points at this server (no https://).
DOMAIN=pos.example.la
# Let's Encrypt contact for certificate expiry notices.
ACME_EMAIL=admin@example.la

# Database
POSTGRES_USER=plc
POSTGRES_PASSWORD=
POSTGRES_DB=plc_pos

# Signs login tokens: at least 32 random characters.
JWT_SECRET=

# First shop and its admin created by the seed (change the admin password after first login).
SEED_TENANT_CODE=plc
SEED_ADMIN_PASSWORD=
# First Super Admin (platform console at https://DOMAIN/lo/platform/login).
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# true = shops can sign up themselves at /signup. Empty DEFAULT_TENANT_CODE = SaaS.
SIGNUP_ENABLED=false
DEFAULT_TENANT_CODE=

# E-mail (confirmation links, password reset, plan invoices). Gmail: smtp.gmail.com,
# 465, true, the address, and an App Password (Google Account → Security → App passwords).
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Optional: "Sign in with Google" (OAuth Web client id). Empty = hidden.
GOOGLE_CLIENT_ID=

# Plan billing: bank details shown on invoices; optional online payment.
BILLING_BANK_INFO=
BILLING_PAY_URL=
BILLING_WEBHOOK_SECRET=

# Days of nightly database dumps kept in deploy/backups.
BACKUP_KEEP_DAYS=14
