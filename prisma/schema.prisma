// PLC POS — database schema. Design notes: docs/database-design.md
//
// Money rules: LAK = Decimal(18, 0), THB/USD = Decimal(18, 2), rates = Decimal(18, 4), percents = Decimal(5, 2).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Currency {
  LAK
  THB
  USD
}

/// Behaviour behind a configurable payment type.
enum PaymentKind {
  CASH
  BANK_TRANSFER
  QR
  CARD
  /// Sale on credit: the amount becomes customer debt.
  CREDIT
}

enum ProductType {
  /// Physical item with stock.
  STANDARD
  /// Set of other products; stock is taken from its components.
  BUNDLE
  /// Installation, repair labour, software licence: no stock.
  SERVICE
}

enum PriceTier {
  RETAIL
  WHOLESALE
}

enum ItemCondition {
  NEW
  /// Display/demo unit sold at its own price.
  DEMO
}

enum SerialStatus {
  IN_STOCK
  SOLD
  RETURNED
  IN_SERVICE
  DEFECTIVE
  /// Taken out of stock by an issue/adjustment document (internal use, damaged, sent back).
  ISSUED
}

enum StockMoveType {
  RECEIVE_IN
  ISSUE_OUT
  ADJUST_IN
  ADJUST_OUT
  SALE_OUT
  RETURN_IN
  VOID_IN
  TRANSFER_OUT
  TRANSFER_IN
}

enum StockDocType {
  /// Goods received (from a supplier or other source).
  RECEIVE
  /// Goods taken out of stock (internal use, damaged, expired, sent back).
  ISSUE
  /// Stock count correction.
  ADJUST
  /// Moves stock from one branch to another.
  TRANSFER
}

enum DocStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum DiscountType {
  PERCENT
  AMOUNT
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum CashMoveType {
  PAY_IN
  PAY_OUT
}

enum TicketStatus {
  RECEIVED
  DIAGNOSING
  QUOTED
  WAITING_PARTS
  SENT_TO_VENDOR
  REPAIRING
  READY
  DELIVERED
  CANCELLED
}

enum TicketLineType {
  PART
  LABOR
}

// ───────────────────────── Users & system ─────────────────────────

/// Configurable user group with a list of permission codes, e.g. ["sale.create","sale.void","price.override"].
model UserGroup {
  id          String   @id @default(uuid())
  tenantId    String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  name        String
  permissions String[]
  /// Built-in groups (Admin, Manager, Cashier, Viewer) cannot be deleted.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users  User[]
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
}

model User {
  id               String    @id @default(uuid())
  /// Preferred UI/API language: lo | th | en (null = tenant default).
  language         String?
  tenantId         String    @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  username         String
  passwordHash     String
  /// 4–6 digit PIN (hashed) for quick cashier login and manager approval at the till.
  pinHash          String?
  /// Consecutive failed password/PIN attempts; reset on success.
  failedLoginCount Int       @default(0)
  /// Set after 5 failed attempts; login is refused until this time.
  lockedUntil      DateTime?
  fullName         String
  /// Optional (cashiers on PIN need none); unique within the company.
  email            String?
  emailVerifiedAt  DateTime?
  /// Google account id ("sub") for Sign in with Google.
  googleSub        String?
  groupId          String
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  group           UserGroup          @relation(fields: [groupId], references: [id])
  tokens          UserToken[]
  refreshTokens   RefreshToken[]
  shifts          Shift[]
  sales           Sale[]             @relation("SaleCashier")
  voidedSales     Sale[]             @relation("SaleVoidedBy")
  priceOverrides  SaleItem[]
  heldBills       HeldBill[]
  quotations      Quotation[]
  saleReturns     SaleReturn[]
  debtPayments    DebtPayment[]
  stockDocuments  StockDocument[]
  stockMovements  StockMovement[]
  cashMovements   CashMovement[]
  expenses        Expense[]
  exchangeRates   ExchangeRate[]
  ticketsReceived ServiceTicket[]
  ticketLogs      ServiceTicketLog[]
  auditLogs       AuditLog[]
  taxInvoices     TaxInvoice[]
  tenant          Tenant             @relation(fields: [tenantId], references: [id])
  branches        UserBranch[]

  @@unique([tenantId, username])
  @@unique([tenantId, email])
  @@unique([tenantId, googleSub])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Key–value settings: "store.name", "store.phone", "store.address", "store.logoUrl",
/// "receipt.defaultSize" (58mm|80mm|A5|A4), "receipt.footer", "repair.warrantyTerms", "tax.pricesIncludeVat", "docNo.prefix.sale" …
model Setting {
  key       String
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  value     Json
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@id([tenantId, key])
}

/// Running counters for document numbers, keyed by prefix + scope, e.g. "S-R1-261026" or "INV-2026".
model DocSequence {
  key      String
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  value    Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, key])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  userId    String?
  /// e.g. "SALE_VOID", "SALE_REPRINT", "PRICE_OVERRIDE", "PRODUCT_PRICE_BULK_UPDATE"
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([tenantId])
}

/// Payment types the shop accepts; can be switched on/off. e.g. "Cash", "BCEL One QR", "LDB transfer", "Credit (debt)".
model PaymentType {
  id                String      @id @default(uuid())
  /// Translations of name, e.g. {"lo": "…", "th": "…", "en": "…"}.
  nameI18n          Json?
  tenantId          String      @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  name              String
  kind              PaymentKind
  requiresReference Boolean     @default(false)
  isActive          Boolean     @default(true)
  sortOrder         Int         @default(0)

  payments     Payment[]
  debtPayments DebtPayment[]
  expenses     Expense[]
  saleReturns  SaleReturn[]
  tenant       Tenant        @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
}

/// VAT/tax rates. Exactly one should be the default.
model TaxRate {
  id        String   @id @default(uuid())
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  name      String
  percent   Decimal  @db.Decimal(5, 2)
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  products   Product[]
  sales      Sale[]
  quotations Quotation[]
  tenant     Tenant      @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
}

/// Units of LAK per 1 unit of `currency` (e.g. USD → 21800). The latest row per currency is current.
model ExchangeRate {
  id            String   @id @default(uuid())
  tenantId      String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  currency      Currency
  lakPerUnit    Decimal  @db.Decimal(18, 4)
  effectiveFrom DateTime @default(now())
  createdById   String?
  createdAt     DateTime @default(now())

  createdBy User?  @relation(fields: [createdById], references: [id])
  tenant    Tenant @relation(fields: [tenantId], references: [id])

  @@index([currency, effectiveFrom])
  @@index([tenantId])
}

// ───────────────────────────── Catalog ─────────────────────────────

model Category {
  id        String  @id @default(uuid())
  /// Translations of name, e.g. {"lo": "…", "th": "…", "en": "…"}.
  nameI18n  Json?
  tenantId  String  @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  name      String
  /// Stable key used by the frontend, e.g. "printer-receipt".
  slug      String
  parentId  String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  parent     Category?       @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[]      @relation("CategoryTree")
  products   Product[]
  promotions PromotionItem[]
  tenant     Tenant          @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, parentId, name])
  @@unique([tenantId, slug])
}

model Brand {
  id       String    @id @default(uuid())
  tenantId String    @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  name     String
  logoUrl  String?
  products Product[]
  tenant   Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
}

model Product {
  id              String      @id @default(uuid())
  /// Translations, e.g. {"lo": "…", "th": "…", "en": "…"}.
  nameI18n        Json?
  descriptionI18n Json?
  tenantId        String      @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  sku             String
  barcode         String?
  name            String
  description     String?
  type            ProductType @default(STANDARD)
  categoryId      String?
  brandId         String?
  /// Manufacturer model, e.g. "TM-T82X".
  model           String?
  /// pcs / box / roll / set
  unit            String      @default("pcs")
  /// Shelf/zone, e.g. "A1".
  location        String?
  /// Category-specific specs, e.g. {"Size":"24\"","Resolution":"1920x1080"}.
  specs           Json?

  /// Prices are kept in `priceCurrency`; when it is THB/USD the LAK price follows the current exchange rate.
  priceCurrency   Currency @default(LAK)
  retailPrice     Decimal  @db.Decimal(18, 2)
  wholesalePrice  Decimal? @db.Decimal(18, 2)
  /// Minimum quantity for the wholesale price to apply automatically (null = wholesale customers only).
  wholesaleMinQty Int?

  /// Latest purchase cost as entered (any currency) …
  costCurrency Currency @default(LAK)
  costPrice    Decimal  @default(0) @db.Decimal(18, 2)
  /// … and the moving-average cost in LAK used for profit reports.
  avgCostLak   Decimal  @default(0) @db.Decimal(18, 0)

  /// false = "unspecified quantity" item (sold without counting stock).
  trackStock     Boolean  @default(true)
  stockQty       Int      @default(0)
  lowStockAlert  Int      @default(0)
  /// Serialized items (terminals, printers, monitors) require a serial per unit sold.
  trackSerial    Boolean  @default(false)
  /// Consumables with expiry dates are received in lots.
  trackExpiry    Boolean  @default(false)
  warrantyMonths Int      @default(0)
  taxRateId      String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category       Category?           @relation(fields: [categoryId], references: [id])
  brand          Brand?              @relation(fields: [brandId], references: [id])
  taxRate        TaxRate?            @relation(fields: [taxRateId], references: [id])
  images         ProductImage[]
  bundleItems    ProductBundleItem[] @relation("Bundle")
  partOfBundles  ProductBundleItem[] @relation("Component")
  serialNumbers  SerialNumber[]
  lots           StockLot[]
  stockMovements StockMovement[]
  stockDocItems  StockDocumentItem[]
  saleItems      SaleItem[]
  quotationItems QuotationItem[]
  promotions     PromotionItem[]
  ticketLines    ServiceTicketLine[]
  tenant         Tenant              @relation(fields: [tenantId], references: [id])
  branchStock    BranchStock[]
  branchPrices   BranchPrice[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([categoryId])
  @@index([brandId])
  /// Trigram indexes (pg_trgm) make "contains" searches fast on large catalogs.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_name_trgm_idx")
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_sku_trgm_idx")
  @@index([barcode(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_barcode_trgm_idx")
  @@index([model(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_model_trgm_idx")
}

model ProductImage {
  id        String @id @default(uuid())
  productId String
  url       String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// Components of a BUNDLE product, e.g. "Restaurant POS set" = terminal + drawer + printer + scanner.
model ProductBundleItem {
  bundleId    String
  componentId String
  quantity    Int    @default(1)

  bundle    Product @relation("Bundle", fields: [bundleId], references: [id], onDelete: Cascade)
  component Product @relation("Component", fields: [componentId], references: [id])

  @@id([bundleId, componentId])
}

model Promotion {
  id           String       @id @default(uuid())
  /// Translations of name, e.g. {"lo": "…", "th": "…", "en": "…"}.
  nameI18n     Json?
  tenantId     String       @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  name         String
  discountType DiscountType
  /// Percent (0–100) or LAK amount per unit.
  value        Decimal      @db.Decimal(18, 2)
  minQty       Int          @default(1)
  startsAt     DateTime
  endsAt       DateTime?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  /// No items = applies to every product.
  items     PromotionItem[]
  saleItems SaleItem[]
  tenant    Tenant          @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

/// Promotion target: either one product or a whole category.
model PromotionItem {
  id          String  @id @default(uuid())
  promotionId String
  productId   String?
  categoryId  String?

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id])
  category  Category? @relation(fields: [categoryId], references: [id])

  @@index([promotionId])
}

// ───────────────────────────── Stock ─────────────────────────────

model SerialNumber {
  id                     String        @id @default(uuid())
  branchId               String
  tenantId               String        @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  serial                 String
  productId              String
  status                 SerialStatus  @default(IN_STOCK)
  condition              ItemCondition @default(NEW)
  /// Own selling price for this unit (demo units); null = product price.
  priceLak               Decimal?      @db.Decimal(18, 0)
  costLak                Decimal?      @db.Decimal(18, 0)
  /// Stock document line it was received on.
  receivedItemId         String?
  /// Latest sale line; full history lives in StockMovement.
  saleItemId             String?
  soldAt                 DateTime?
  warrantyEndsAt         DateTime?
  /// Warranty the supplier gives the shop (for claims back to the vendor).
  supplierWarrantyEndsAt DateTime?
  createdAt              DateTime      @default(now())

  product      Product            @relation(fields: [productId], references: [id])
  receivedItem StockDocumentItem? @relation(fields: [receivedItemId], references: [id])
  saleItem     SaleItem?          @relation(fields: [saleItemId], references: [id])
  movements    StockMovement[]
  tickets      ServiceTicket[]
  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  branch       Branch             @relation(fields: [branchId], references: [id])

  @@unique([tenantId, serial])
  @@index([productId, status])
  @@index([saleItemId])
  @@index([receivedItemId])
  @@index([branchId])
}

/// Received lot with an expiry date (thermal paper, ink, batteries …).
model StockLot {
  id         String   @id @default(uuid())
  branchId   String
  tenantId   String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  productId  String
  lotNo      String?
  expiryDate DateTime
  qty        Int
  receivedAt DateTime @default(now())

  product   Product         @relation(fields: [productId], references: [id])
  movements StockMovement[]
  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  branch    Branch          @relation(fields: [branchId], references: [id])

  @@index([expiryDate])
  @@index([productId, expiryDate])
  @@index([tenantId])
  @@index([branchId])
}

model Supplier {
  id        String   @id @default(uuid())
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  name      String
  phone     String?
  email     String?
  address   String?
  taxId     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stockDocuments StockDocument[]
  serviceTickets ServiceTicket[]
  tenant         Tenant          @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

/// Goods receipt / stock issue / stock adjustment document.
model StockDocument {
  id          String       @id @default(uuid())
  /// Branch whose stock changes (for TRANSFER: the sending branch).
  branchId    String
  /// TRANSFER only: the receiving branch.
  toBranchId  String?
  tenantId    String       @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  docNo       String
  type        StockDocType
  status      DocStatus    @default(DRAFT)
  supplierId  String?
  /// Supplier invoice no. for RECEIVE, reason for ISSUE/ADJUST.
  reference   String?
  note        String?
  currency    Currency     @default(LAK)
  lakPerUnit  Decimal      @default(1) @db.Decimal(18, 4)
  totalLak    Decimal      @default(0) @db.Decimal(18, 0)
  createdById String
  postedAt    DateTime?
  createdAt   DateTime     @default(now())

  supplier  Supplier?           @relation(fields: [supplierId], references: [id])
  createdBy User                @relation(fields: [createdById], references: [id])
  items     StockDocumentItem[]
  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  branch    Branch              @relation("DocBranch", fields: [branchId], references: [id])
  toBranch  Branch?             @relation("DocToBranch", fields: [toBranchId], references: [id])

  @@unique([tenantId, docNo])
  @@index([type, createdAt])
  @@index([branchId])
}

model StockDocumentItem {
  id           String        @id @default(uuid())
  documentId   String
  productId    String
  /// Positive for RECEIVE/ISSUE; signed for ADJUST.
  quantity     Int
  /// Unit cost in the document currency (RECEIVE only).
  unitCost     Decimal       @default(0) @db.Decimal(18, 2)
  unitCostLak  Decimal       @default(0) @db.Decimal(18, 0)
  condition    ItemCondition @default(NEW)
  lotNo        String?
  expiryDate   DateTime?
  /// Serial numbers entered on the draft; turned into SerialNumber rows when posted.
  draftSerials String[]

  document StockDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product  Product        @relation(fields: [productId], references: [id])
  serials  SerialNumber[]

  @@index([documentId])
  @@index([productId])
}

/// Stock ledger — insert-only. Product.stockQty must equal the sum of `quantity` per product.
model StockMovement {
  id           String        @id @default(uuid())
  branchId     String
  tenantId     String        @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  productId    String
  type         StockMoveType
  /// + in / − out
  quantity     Int
  balanceAfter Int
  unitCostLak  Decimal?      @db.Decimal(18, 0)
  serialId     String?
  lotId        String?
  /// "STOCK_DOC" | "SALE" | "SALE_RETURN" | "SERVICE_TICKET"
  refType      String
  refId        String
  userId       String
  createdAt    DateTime      @default(now())

  product Product       @relation(fields: [productId], references: [id])
  serial  SerialNumber? @relation(fields: [serialId], references: [id])
  lot     StockLot?     @relation(fields: [lotId], references: [id])
  user    User          @relation(fields: [userId], references: [id])
  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  branch  Branch        @relation(fields: [branchId], references: [id])

  @@index([productId, createdAt])
  @@index([refType, refId])
  @@index([tenantId])
  @@index([branchId])
}

// ───────────────────────────── Sales ─────────────────────────────

model Customer {
  id             String       @id @default(uuid())
  tenantId       String       @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  code           String
  name           String
  type           CustomerType @default(INDIVIDUAL)
  companyName    String?
  taxId          String?
  phone          String?
  email          String?
  address        String?
  priceTier      PriceTier    @default(RETAIL)
  /// 0 = no credit allowed.
  creditLimitLak Decimal      @default(0) @db.Decimal(18, 0)
  note           String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  sales        Sale[]
  heldBills    HeldBill[]
  quotations   Quotation[]
  debtPayments DebtPayment[]
  tickets      ServiceTicket[]
  tenant       Tenant          @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@unique([tenantId, phone])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Customer_name_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "Customer_phone_trgm_idx")
}

/// Parked ("held") cart that does not touch stock until it is completed as a Sale.
model HeldBill {
  id         String   @id @default(uuid())
  branchId   String?
  tenantId   String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  label      String?
  cashierId  String
  customerId String?
  /// Cart snapshot: [{productId, quantity, unitPriceLak, discountLak, serials[]}], bill discount, note.
  cart       Json
  createdAt  DateTime @default(now())

  cashier  User      @relation(fields: [cashierId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  branch   Branch?   @relation(fields: [branchId], references: [id])

  @@index([cashierId])
  @@index([tenantId])
  @@index([branchId])
}

model Quotation {
  id          String          @id @default(uuid())
  branchId    String?
  tenantId    String          @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  quoteNo     String
  customerId  String
  status      QuotationStatus @default(DRAFT)
  validUntil  DateTime
  subtotalLak Decimal         @db.Decimal(18, 0)
  discountLak Decimal         @default(0) @db.Decimal(18, 0)
  taxRateId   String?
  vatPercent  Decimal         @default(0) @db.Decimal(5, 2)
  vatLak      Decimal         @default(0) @db.Decimal(18, 0)
  totalLak    Decimal         @db.Decimal(18, 0)
  note        String?
  createdById String
  createdAt   DateTime        @default(now())

  customer  Customer        @relation(fields: [customerId], references: [id])
  taxRate   TaxRate?        @relation(fields: [taxRateId], references: [id])
  createdBy User            @relation(fields: [createdById], references: [id])
  items     QuotationItem[]
  sale      Sale?
  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  branch    Branch?         @relation(fields: [branchId], references: [id])

  @@unique([tenantId, quoteNo])
  @@index([customerId])
  @@index([branchId])
}

model QuotationItem {
  id           String  @id @default(uuid())
  quotationId  String
  productId    String
  productName  String
  quantity     Int
  unitPriceLak Decimal @db.Decimal(18, 0)
  discountLak  Decimal @default(0) @db.Decimal(18, 0)
  lineTotalLak Decimal @db.Decimal(18, 0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@index([quotationId])
}

model Sale {
  id            String        @id @default(uuid())
  branchId      String
  tenantId      String        @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  receiptNo     String
  status        SaleStatus    @default(COMPLETED)
  paymentStatus PaymentStatus @default(PAID)
  cashierId     String
  registerId    String?
  shiftId       String?
  customerId    String?
  quotationId   String?       @unique
  priceTier     PriceTier     @default(RETAIL)

  subtotalLak      Decimal   @db.Decimal(18, 0)
  /// Whole-bill discount (line discounts are on SaleItem).
  discountLak      Decimal   @default(0) @db.Decimal(18, 0)
  taxRateId        String?
  vatPercent       Decimal   @default(0) @db.Decimal(5, 2)
  pricesIncludeVat Boolean   @default(true)
  vatLak           Decimal   @default(0) @db.Decimal(18, 0)
  totalLak         Decimal   @db.Decimal(18, 0)
  /// Sum of non-credit payments (+ later debt payments); totalLak − paidLak = outstanding debt.
  paidLak          Decimal   @default(0) @db.Decimal(18, 0)
  changeLak        Decimal   @default(0) @db.Decimal(18, 0)
  dueDate          DateTime?

  note       String?
  printCount Int       @default(0)
  voidedById String?
  voidedAt   DateTime?
  voidReason String?
  createdAt  DateTime  @default(now())

  cashier      User           @relation("SaleCashier", fields: [cashierId], references: [id])
  voidedBy     User?          @relation("SaleVoidedBy", fields: [voidedById], references: [id])
  register     Register?      @relation(fields: [registerId], references: [id])
  shift        Shift?         @relation(fields: [shiftId], references: [id])
  customer     Customer?      @relation(fields: [customerId], references: [id])
  quotation    Quotation?     @relation(fields: [quotationId], references: [id])
  taxRate      TaxRate?       @relation(fields: [taxRateId], references: [id])
  items        SaleItem[]
  payments     Payment[]
  returns      SaleReturn[]
  debtPayments DebtPayment[]
  ticket       ServiceTicket?
  taxInvoices  TaxInvoice[]
  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  branch       Branch         @relation(fields: [branchId], references: [id])

  @@unique([tenantId, receiptNo])
  @@index([tenantId, createdAt])
  @@index([customerId, paymentStatus])
  @@index([shiftId])
  @@index([tenantId, status, createdAt])
  @@index([cashierId, createdAt])
  @@index([branchId])
}

/// Formal VAT invoice (A4) for a sale. Buyer details are snapshotted so later customer edits don't change issued invoices.
/// At most one non-cancelled invoice per sale (partial unique index in the migration).
model TaxInvoice {
  id           String    @id @default(uuid())
  tenantId     String    @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  /// Own running sequence, separate from receipt numbers, e.g. "INV-2026-000123".
  invoiceNo    String
  saleId       String
  buyerName    String
  buyerTaxId   String?
  buyerAddress String?
  buyerPhone   String?
  issuedById   String
  issuedAt     DateTime  @default(now())
  /// Cancelled invoices keep their number; a new invoice is issued instead.
  cancelledAt  DateTime?
  cancelReason String?

  sale     Sale   @relation(fields: [saleId], references: [id])
  issuedBy User   @relation(fields: [issuedById], references: [id])
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, invoiceNo])
  @@index([saleId])
  @@index([issuedAt])
}

model SaleItem {
  id                  String  @id @default(uuid())
  tenantId            String  @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  saleId              String
  productId           String
  /// Snapshot of product name at time of sale.
  productName         String
  quantity            Int
  /// List price for the tier at sale time …
  listPriceLak        Decimal @db.Decimal(18, 0)
  /// … and the price actually charged (differs when overridden or a demo unit).
  unitPriceLak        Decimal @db.Decimal(18, 0)
  priceOverriddenById String?
  promotionId         String?
  discountLak         Decimal @default(0) @db.Decimal(18, 0)
  lineTotalLak        Decimal @db.Decimal(18, 0)
  /// Cost snapshot for profit reports.
  unitCostLak         Decimal @db.Decimal(18, 0)
  warrantyMonths      Int     @default(0)

  sale              Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product           Product          @relation(fields: [productId], references: [id])
  priceOverriddenBy User?            @relation(fields: [priceOverriddenById], references: [id])
  promotion         Promotion?       @relation(fields: [promotionId], references: [id])
  serialNumbers     SerialNumber[]
  returnItems       SaleReturnItem[]
  tenant            Tenant           @relation(fields: [tenantId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@index([tenantId])
}

/// One sale may be paid with several payments in different currencies and types.
model Payment {
  id            String   @id @default(uuid())
  saleId        String
  paymentTypeId String
  currency      Currency
  /// Amount tendered in `currency`.
  amount        Decimal  @db.Decimal(18, 2)
  /// Exchange-rate snapshot (1 for LAK).
  lakPerUnit    Decimal  @db.Decimal(18, 4)
  amountLak     Decimal  @db.Decimal(18, 0)
  /// Transfer / QR / card reference.
  reference     String?
  createdAt     DateTime @default(now())

  sale        Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  paymentType PaymentType @relation(fields: [paymentTypeId], references: [id])

  @@index([saleId])
}

/// Customer paying off credit-sale debt (may be partial).
model DebtPayment {
  id            String   @id @default(uuid())
  branchId      String?
  tenantId      String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  receiptNo     String
  customerId    String
  saleId        String
  paymentTypeId String
  currency      Currency
  amount        Decimal  @db.Decimal(18, 2)
  lakPerUnit    Decimal  @db.Decimal(18, 4)
  amountLak     Decimal  @db.Decimal(18, 0)
  reference     String?
  shiftId       String?
  receivedById  String
  createdAt     DateTime @default(now())

  customer    Customer    @relation(fields: [customerId], references: [id])
  sale        Sale        @relation(fields: [saleId], references: [id])
  paymentType PaymentType @relation(fields: [paymentTypeId], references: [id])
  shift       Shift?      @relation(fields: [shiftId], references: [id])
  receivedBy  User        @relation(fields: [receivedById], references: [id])
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  branch      Branch?     @relation(fields: [branchId], references: [id])

  @@unique([tenantId, receiptNo])
  @@index([customerId, createdAt])
  @@index([saleId])
  @@index([shiftId])
  @@index([branchId])
}

model SaleReturn {
  id            String   @id @default(uuid())
  tenantId      String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  returnNo      String
  saleId        String
  reason        String
  refundLak     Decimal  @db.Decimal(18, 0)
  paymentTypeId String
  /// Shift the refund was paid from (cash refunds lower the drawer's expected cash).
  shiftId       String?
  createdById   String
  createdAt     DateTime @default(now())

  sale        Sale             @relation(fields: [saleId], references: [id])
  shift       Shift?           @relation(fields: [shiftId], references: [id])
  paymentType PaymentType      @relation(fields: [paymentTypeId], references: [id])
  createdBy   User             @relation(fields: [createdById], references: [id])
  items       SaleReturnItem[]
  tenant      Tenant           @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, returnNo])
  @@index([saleId])
  @@index([shiftId])
  @@index([createdAt])
}

model SaleReturnItem {
  id         String   @id @default(uuid())
  returnId   String
  saleItemId String
  quantity   Int
  serials    String[]
  /// false = defective, not put back on sale.
  restock    Boolean  @default(true)
  amountLak  Decimal  @db.Decimal(18, 0)

  saleReturn SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id])

  @@index([returnId])
  @@index([saleItemId])
}

// ───────────────────────── Shifts, cash & expenses ─────────────────────────

/// A till / checkout counter. Each has its own receipt printer, cash drawer and shift.
model Register {
  id       String  @id @default(uuid())
  branchId String
  tenantId String  @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  /// Short code used in document numbers, e.g. "R1".
  code     String
  name     String
  /// ESC/POS printer settings used by the local print bridge,
  /// e.g. {"connection":"usb|lan","host":"192.168.1.50","port":9100,"paperWidth":80,"openDrawer":true}.
  printer  Json?
  isActive Boolean @default(true)

  shifts Shift[]
  sales  Sale[]
  tenant Tenant  @relation(fields: [tenantId], references: [id])
  branch Branch  @relation(fields: [branchId], references: [id])

  @@unique([tenantId, code])
  @@index([branchId])
}

/// At most one OPEN shift per register (enforced by a partial unique index in the migration).
model Shift {
  id           String      @id @default(uuid())
  tenantId     String      @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  registerId   String
  userId       String
  status       ShiftStatus @default(OPEN)
  openedAt     DateTime    @default(now())
  closedAt     DateTime?
  /// Cash counted per currency, e.g. {"LAK":"500000","THB":"0","USD":"20"}.
  openingCash  Json
  closingCash  Json?
  /// System-calculated cash per currency at close.
  expectedCash Json?
  note         String?

  register      Register       @relation(fields: [registerId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  sales         Sale[]
  debtPayments  DebtPayment[]
  cashMovements CashMovement[]
  expenses      Expense[]
  saleReturns   SaleReturn[]
  tenant        Tenant         @relation(fields: [tenantId], references: [id])

  @@index([registerId, status])
  @@index([tenantId])
}

/// Cash put into / taken out of the drawer during a shift (not an expense).
model CashMovement {
  id        String       @id @default(uuid())
  tenantId  String       @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  shiftId   String
  type      CashMoveType
  currency  Currency
  amount    Decimal      @db.Decimal(18, 2)
  reason    String
  userId    String
  createdAt DateTime     @default(now())

  shift  Shift  @relation(fields: [shiftId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([shiftId])
  @@index([tenantId])
}

model ExpenseCategory {
  id       String    @id @default(uuid())
  /// Translations of name, e.g. {"lo": "…", "th": "…", "en": "…"}.
  nameI18n Json?
  tenantId String    @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  name     String
  isActive Boolean   @default(true)
  expenses Expense[]
  tenant   Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
}

model Expense {
  id            String   @id @default(uuid())
  branchId      String?
  tenantId      String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  categoryId    String
  description   String
  currency      Currency
  amount        Decimal  @db.Decimal(18, 2)
  lakPerUnit    Decimal  @db.Decimal(18, 4)
  amountLak     Decimal  @db.Decimal(18, 0)
  paymentTypeId String
  /// Set when paid from the drawer, so shift cash balances.
  shiftId       String?
  attachmentUrl String?
  spentAt       DateTime @default(now())
  createdById   String
  createdAt     DateTime @default(now())

  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  paymentType PaymentType     @relation(fields: [paymentTypeId], references: [id])
  shift       Shift?          @relation(fields: [shiftId], references: [id])
  createdBy   User            @relation(fields: [createdById], references: [id])
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  branch      Branch?         @relation(fields: [branchId], references: [id])

  @@index([spentAt])
  @@index([shiftId])
  @@index([categoryId])
  @@index([tenantId])
  @@index([branchId])
}

// ───────────────────────────── Repair / warranty ─────────────────────────────

model ServiceTicket {
  id            String       @id @default(uuid())
  branchId      String
  tenantId      String       @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  ticketNo      String
  status        TicketStatus @default(RECEIVED)
  customerId    String
  /// Set when the device was sold by this shop.
  serialId      String?
  deviceName    String
  deviceSerial  String?
  accessories   String?
  problem       String
  diagnosis     String?
  underWarranty Boolean      @default(false)
  /// Repair quotation total (from lines).
  quotedLak     Decimal      @default(0) @db.Decimal(18, 0)
  /// Warranty given on this repair.
  warrantyDays  Int          @default(0)
  warrantyTerms String?
  /// Payment bill for the repair.
  saleId        String?      @unique
  /// Vendor the device was sent to for a warranty claim (status SENT_TO_VENDOR).
  supplierId    String?
  receivedById  String
  receivedAt    DateTime     @default(now())
  promisedAt    DateTime?
  deliveredAt   DateTime?

  customer   Customer            @relation(fields: [customerId], references: [id])
  supplier   Supplier?           @relation(fields: [supplierId], references: [id])
  serial     SerialNumber?       @relation(fields: [serialId], references: [id])
  sale       Sale?               @relation(fields: [saleId], references: [id])
  receivedBy User                @relation(fields: [receivedById], references: [id])
  lines      ServiceTicketLine[]
  logs       ServiceTicketLog[]
  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  branch     Branch              @relation(fields: [branchId], references: [id])

  @@unique([tenantId, ticketNo])
  @@index([status])
  @@index([customerId])
  @@index([branchId])
}

/// Parts and labour on a repair quotation / bill.
model ServiceTicketLine {
  id           String         @id @default(uuid())
  ticketId     String
  type         TicketLineType
  productId    String?
  description  String
  quantity     Int            @default(1)
  unitPriceLak Decimal        @db.Decimal(18, 0)
  lineTotalLak Decimal        @db.Decimal(18, 0)

  ticket  ServiceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  product Product?      @relation(fields: [productId], references: [id])

  @@index([ticketId])
}

/// Status history of a repair ticket.
model ServiceTicketLog {
  id        String       @id @default(uuid())
  ticketId  String
  status    TicketStatus
  note      String?
  userId    String
  createdAt DateTime     @default(now())

  ticket ServiceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id])

  @@index([ticketId])
}

// ───────────────────────── SaaS: tenants, branches, plans ─────────────────────────

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  /// Period ended: usable during the grace period, then read-only.
  PAST_DUE
  /// Blocked by the platform (no login).
  SUSPENDED
  CANCELLED
}

/// A company renting the POS. Every tenant table carries tenantId (docs/saas-design.md).
model Tenant {
  id              String   @id @default(uuid())
  /// Short code typed at login, e.g. "plc".
  code            String   @unique
  name            String
  legalName       String?
  taxId           String?
  phone           String?
  email           String?
  /// lo | th | en
  defaultLanguage String   @default("lo")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscription      Subscription?
  branches          Branch[]
  branchStock       BranchStock[]
  branchPrices      BranchPrice[]
  userTokens        UserToken[]
  invoices          BillingInvoice[]
  idempotencyKeys   IdempotencyKey[]
  userGroups        UserGroup[]
  users             User[]
  settings          Setting[]
  docSequences      DocSequence[]
  auditLogs         AuditLog[]
  paymentTypes      PaymentType[]
  taxRates          TaxRate[]
  exchangeRates     ExchangeRate[]
  categories        Category[]
  brands            Brand[]
  products          Product[]
  promotions        Promotion[]
  serialNumbers     SerialNumber[]
  stockLots         StockLot[]
  suppliers         Supplier[]
  stockDocuments    StockDocument[]
  stockMovements    StockMovement[]
  customers         Customer[]
  heldBills         HeldBill[]
  quotations        Quotation[]
  sales             Sale[]
  saleItems         SaleItem[]
  taxInvoices       TaxInvoice[]
  debtPayments      DebtPayment[]
  saleReturns       SaleReturn[]
  registers         Register[]
  shifts            Shift[]
  cashMovements     CashMovement[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  serviceTickets    ServiceTicket[]
}

model Branch {
  id            String   @id @default(uuid())
  tenantId      String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  code          String
  name          String
  address       String?
  phone         String?
  /// Extra line printed on receipts of this branch.
  receiptHeader String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  stock             BranchStock[]
  users             UserBranch[]
  stockDocuments    StockDocument[] @relation("DocBranch")
  incomingTransfers StockDocument[] @relation("DocToBranch")
  registers         Register[]
  sales             Sale[]
  stockMovements    StockMovement[]
  serials           SerialNumber[]
  lots              StockLot[]
  serviceTickets    ServiceTicket[]
  expenses          Expense[]
  quotations        Quotation[]
  prices            BranchPrice[]
  heldBills         HeldBill[]
  debtPayments      DebtPayment[]

  @@unique([tenantId, code])
}

/// On-hand quantity per branch. Product.stockQty is the sum over branches.
model BranchStock {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  branchId  String
  productId String
  qty       Int      @default(0)
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@id([branchId, productId])
  @@index([tenantId])
  @@index([productId])
}

/// Branches a user may work in; a user without rows may work in every branch.
model UserBranch {
  userId   String
  branchId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@index([branchId])
}

/// A package the platform sells. Limits/features are editable at any time.
model Plan {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  nameI18n        Json?
  descriptionI18n Json?
  priceMonthlyLak Decimal  @default(0) @db.Decimal(18, 0)
  priceYearlyLak  Decimal  @default(0) @db.Decimal(18, 0)
  /// { maxBranches, maxRegisters, maxUsers, maxProducts, maxSalesPerMonth } — null = unlimited.
  limits          Json
  /// Feature keys, see src/plans/features.ts.
  features        String[]
  trialDays       Int      @default(14)
  /// Shown on the public plan list / signup.
  isPublic        Boolean  @default(true)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions Subscription[]
  invoices      BillingInvoice[]
}

model Subscription {
  id               String             @id @default(uuid())
  tenantId         String             @unique
  planId           String
  status           SubscriptionStatus @default(TRIAL)
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  /// Per-tenant changes: { limits?: {...}, featuresAdd?: [], featuresRemove?: [] }.
  overrides        Json?
  note             String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([planId])
}

/// Platform staff (us). Separate login realm from tenant users.
model PlatformAdmin {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  fullName         String
  isActive         Boolean   @default(true)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// Replays the stored response when a client retries a request with the same Idempotency-Key.
model IdempotencyKey {
  tenantId    String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  key         String
  userId      String
  method      String
  path        String
  /// SHA-256 of the request body: the same key with a different body is refused.
  requestHash String
  statusCode  Int?
  response    Json?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, key])
  @@index([createdAt])
}

/// Selling price of a product at one branch (in the product's price currency). No row:
/// the product's own price applies; wholesalePrice null: the product's wholesale price.
model BranchPrice {
  tenantId       String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  branchId       String
  productId      String
  retailPrice    Decimal  @db.Decimal(18, 2)
  wholesalePrice Decimal? @db.Decimal(18, 2)
  updatedAt      DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([branchId, productId])
  @@index([productId])
  @@index([tenantId])
}

enum UserTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// One-time e-mail links (verify address, reset password). Only the hash is stored.
model UserToken {
  id        String           @id @default(uuid())
  tenantId  String           @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  userId    String
  purpose   UserTokenPurpose
  email     String
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([tenantId])
}

/// A sign-up waiting for its e-mail code. The company is created only after verification.
/// Not tenant data: there is no tenant yet.
model SignupRequest {
  id         String    @id @default(uuid())
  email      String
  /// Company code asked for (re-checked when verifying).
  code       String
  /// Sign-up form without the plain password (passwordHash instead).
  payload    Json
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
}

/// Invoice for a plan period, paid by bank transfer or an online gateway.
model BillingInvoice {
  id        String        @id @default(uuid())
  tenantId  String        @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  number    String
  planId    String
  months    Int
  amountLak Decimal       @db.Decimal(18, 0)
  status    InvoiceStatus @default(PENDING)
  /// BANK_TRANSFER, ONLINE, MANUAL …
  method    String?
  reference String?
  paidAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  plan   Plan   @relation(fields: [planId], references: [id])

  @@unique([tenantId, number])
  @@index([status, createdAt])
  @@index([planId])
}
